# Run: python3 scripts/configure.py (creates random local secrets; never overwrites).
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
APP_UID=10001
APP_GID=10001
DATABASE_URL=
JWT_SECRET=
TOTP_KEY=
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
DATA_DIR=/data
BACKUP_DIR=/backups
# Host path: initially local staging. Set to another mounted disk/NAS for protection.
BACKUP_HOST_DIR=./data/backups
APP_COMMIT=development
