# Run: python3 scripts/configure.py (creates random local secrets; never overwrites).
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
APP_UID=10001
APP_GID=10001
DATABASE_URL=
JWT_SECRET=
TOTP_KEY=
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
DATA_DIR=/data
BACKUP_DIR=/backups
# Host path: initially local staging. Set to another mounted disk/NAS for protection.
BACKUP_HOST_DIR=./data/backups
APP_COMMIT=development

# Optional capture bridge. Use scripts/configure-capture.py; keep disabled until configured.
COMPOSE_PROFILES=
CAPTURE_PROVIDER=disabled
CAPTURE_MODEL=
CAPTURE_BRIDGE_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=0
TELEGRAM_USER_ID=0
OPENAI_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
